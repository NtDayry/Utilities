# =====================================================================
# Utilities stack (ระบบทั้งหมด) — คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูก commit)
# =====================================================================

# ---------- Application (เดิมของ PurifiedWater) ----------
APP_NAME=Utilities Service
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
TZ=Asia/Bangkok

# ---------- JWT / Auth ----------
# ใช้ค่าเดิมจาก D:\Utilities\.env → ผู้ใช้ไม่ต้อง login ใหม่ / token เดิมยังใช้ได้
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# admin ตั้งต้น (ใช้เฉพาะตอนตาราง users ว่าง)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
APP_ADMIN_ROLE=super admin

# ---------- SMTP (อีเมลแจ้งเตือน) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Purifield Water Alarm System
SMTP_TLS=true

# ---------- ข้อมูล ----------
# โฟลเดอร์ข้อมูลถาวร: database/postgres/data, redis, mosquitto, uploads, profile, support-team, backups
# ../storage = โฟลเดอร์ข้อมูลเดิมของ PurifiedWater (ได้ผู้ใช้ / ประวัติ / ไฟล์เดิมทั้งหมด)
STORAGE_ROOT=../storage

# ---------- PostgreSQL + TimescaleDB ----------
# ถ้าใช้โฟลเดอร์ข้อมูลเดิม ต้องตรงกับค่าเดิม (docker-compose.yml เดิม: engineer / purified-water)
# ห้ามมี @ : / # ในรหัสผ่าน (ใช้ประกอบ DATABASE_URL)
POSTGRES_USER=engineer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=purified-water
DB_PORT=5432

# ---------- พอร์ต ----------
HTTP_PORT=80
HTTPS_PORT=443
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ---------- Mosquitto ----------
MQTT_USERNAME=utilities
MQTT_PASSWORD=change-me
# bridge ดึงข้อมูลจาก broker เดิม (ว่าง = ไม่ทำ bridge) — ต้องเป็นพอร์ต MQTT แบบ TCP
# แต่ละ topic T: รับ T, T/settings, T/configs — ส่ง T/set กลับ
MQTT_BRIDGE_ADDRESS=192.168.12.77:1884
MQTT_BRIDGE_USERNAME=polipharm
MQTT_BRIDGE_PASSWORD=change-me
MQTT_BRIDGE_TOPICS=water-system-production

# ---------- ระบบน้ำ / MQTT ----------
# DEFAULT_MQTT_URL=mqtt://utilities-mqtt:1883
MQTT_EXTRA_TOPICS=water-system-production,water-system-production/settings,water-system-production/configs
MQTT_CONTROL_TOPICS=water-system-production
METRIC_SAMPLE_SEC=10
RAW_MESSAGE_SAMPLE_SEC=60
COMM_TIMEOUT_SEC=60
ALARM_ENGINE_ENABLED=true
ALARM_LEVEL_DEADBAND_PCT=1
ADMIN_ROLES=super admin,admin
RAW_RETENTION_DAYS=90
AGG_1M_RETENTION_DAYS=400
AGG_1H_RETENTION_DAYS=0
MESSAGE_RETENTION_DAYS=30
COMPRESS_AFTER_DAYS=7

# ---------- Modbus RS485 reader (เลิกใช้) ----------
# Purified Water รับค่าทาง MQTT แล้ว: ตั้ง broker / topic / field ในหน้า purified-water/settings
# เปิดตัวอ่าน RS485 เดิมกลับมา: COMPOSE_PROFILES=modbus (ห้ามเปิดพร้อม MQTT — ค่าจะบันทึกซ้ำ)
# COMPOSE_PROFILES=modbus
SERIAL_DEVICE=/dev/ttyACM0
BAUD_RATE=9600
DEVICE_TOKEN=

# ---------- nginx ----------
# SSL_DIR=./nginx/ssl           (server.crt + server.key)
# ---------- หน้าเว็บ (build ใน Docker จาก ../frontend-utilities) ----------
# FRONTEND_SRC=../frontend-utilities
# FRONTEND_PROJECT_NAME=Utilities System
