# nginx ของ Utilities stack (template — ${HTTPS_PORT} ถูกแทนค่าจาก environment ตอนเริ่ม container)
#
#   /api/  /ws/  /static/  /storage/   → utilities-api (ระบบหลักเดิม + /api/utilities/* + /ws/utilities/*)
#   /mqtt                              → Mosquitto (MQTT over WebSocket สำหรับหน้าเว็บ: wss://<host>/mqtt)
#   /portainer/                        → Portainer
#   /                                  → frontend-utilities (React build)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    location / {
        return 308 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # resolve ชื่อ container ตอนใช้งาน (nginx เริ่มได้แม้ service อื่นยังไม่พร้อม)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api utilities-api:8000;
    set $mqtt utilities-mqtt:9001;

    # ไม่จำกัดขนาด (อัปโหลดไฟล์ backup ขนาดใหญ่ — เหมือน stack เดิม)
    client_max_body_size 0;
    client_body_timeout 1800s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;

    # ---------------- API ----------------
    location /api/ {
        proxy_pass http://$api$request_uri;
        proxy_read_timeout 1800s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 1800s;
        proxy_request_buffering off;
    }

    # ---------------- WebSocket (/ws/sensor-data, /ws/monitor, /ws/backup, /ws/utilities/mqtt) ----------------
    location /ws/ {
        proxy_pass http://$api$request_uri;
        proxy_http_version 1.1;
        # location ที่ตั้ง proxy_set_header เอง จะไม่สืบทอดค่าจาก server → ใส่ซ้ำ
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # ไฟล์อัปโหลด / รูปโปรไฟล์ / support team (FastAPI เสิร์ฟ)
    location /static/ {
        proxy_pass http://$api$request_uri;
    }
    location /storage/ {
        proxy_pass http://$api$request_uri;
    }

    # ---------------- MQTT over WebSocket ----------------
    location = /mqtt {
        proxy_pass http://$mqtt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # ---------------- Portainer ----------------
    location /portainer/ {
        set $portainer portainer:9443;
        # proxy_pass ที่ใช้ตัวแปรจะไม่ตัด prefix ให้ → ตัด /portainer เอง
        rewrite ^/portainer/(.*)$ /$1 break;
        proxy_pass https://$portainer;
    }

    # ---------------- frontend-utilities ----------------
    location /assets/ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
