# =========================================
# .env — ทุกโหมด
# =========================================
VITE_COPYRIGHT=Copyright © 2026 Engineering Department All Rights Reserved. # for production
VITE_PROJECT_NAME=Utilities System
VITE_CREDITE=By Engineering

# =========================================
# .env.development — npm run dev
# =========================================
# origin ของ backend-utilities (nginx) ที่ Vite ส่ง /api /ws /storage /static ไปหา — ไม่ใส่ path
# VITE_BASE_URL=https://localhost
# WebSocket ใช้ host เดียวกันโดยอัตโนมัติ (https → wss) ; ใส่เฉพาะเมื่อ WebSocket อยู่คนละ host
# VITE_WS_TARGET=wss://localhost

# =========================================
# .env.production — npm run build นอก Docker (ใน Docker ใช้ค่าจาก backend-utilities/frontend/Dockerfile)
# =========================================
# VITE_BASE_URL=/api

# =========================================
# ทุกโหมด (ไม่บังคับ)
# =========================================
# broker พื้นฐานของ backend — แสดงผลเท่านั้น (ค่าเริ่มต้น mqtt://utilities-mqtt:1883)
# VITE_MQTT_WATER_URL=mqtt://utilities-mqtt:1883
#
# MQTT ทั้งหมดผ่าน backend (/ws/utilities/mqtt) — หน้าเว็บไม่ต่อ broker เอง และไม่มีชื่อผู้ใช้/รหัสผ่าน broker ในไฟล์ .env ของหน้าเว็บ
